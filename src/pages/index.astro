---
import "../styles/global.css";
import { products as countryCollections } from "../data/products";

const categories = [
  { name: "T-SHIRTS", note: "The everyday standard", image: "https://images.unsplash.com/photo-1519058082700-08a0b56da9b4?auto=format&fit=crop&w=1200&q=88", number: "01" },
  { name: "HOODIES", note: "Layers for the brotherhood", image: "https://images.unsplash.com/photo-1620532393942-ceb8baf5f8a0?auto=format&fit=crop&w=1200&q=88", number: "02" },
  { name: "SWEATSHIRTS", note: "The heritage layer", image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1200&q=88", number: "03" },
  { name: "CAPS", note: "The finishing mark", image: "https://images.unsplash.com/photo-1544435253-f0ead49638fa?auto=format&fit=crop&w=1200&q=88", number: "04" }
];
const logo = "https://d2ol7oe51mr4n9.cloudfront.net/user_39LyNd3yWOiGeUhnS3CdfDw25su/c14fa22d-dcdf-4531-ac68-c193884954df.png";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="AirBorneSoldier — premium heritage streetwear for the global airborne community. The Sky Brotherhood. Built on belonging." />
  <meta name="theme-color" content="#eee9df" />
  <meta property="og:title" content="AirBorneSoldier — The Sky Brotherhood" />
  <meta property="og:description" content="Heritage streetwear for the airborne community. Built on belonging." />
  <title>AirBorneSoldier® — The Sky Brotherhood</title>
</head>
<body>
  <div class="topline">
    <span class="topline-rule"></span>
    <span>THE SKY BROTHERHOOD — BUILT ON BELONGING</span>
    
    <span class="topline-markets">UK · EUROPE · USA</span>
    <span class="topline-rule"></span>
  </div>

  <header class="masthead">
    <a class="brand" href="/" aria-label="AirBorneSoldier home">
      <img src={logo} alt="AirBorneSoldier — The Sky Brotherhood" />
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a class="active" href="/">HOME</a>
      <a href="/collection/">COLLECTION <span class="chevron">⌄</span></a>
      <a href="#story">OUR STORY</a>
      <a href="#journal">JOURNAL</a>
      <a href="mailto:valskermsoldaat@gmail.com">CONTACT</a>
    </nav>
    <a class="header-cta" href="/collection/">SHOP THE COLLECTION <span>→</span></a><a class="header-utility" href="/collection/" aria-label="View collection">⌕</a><a class="header-utility header-bag" href="/collection/" aria-label="Browse products">◯</a>
    <a class="mobile-collection" href="/collection/">COLLECTION ↗</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-photo" role="img" aria-label="Traditional round military parachutes descending over a mountain drop zone"></div>
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span></span> AIRBORNE SOLDIER</p>
        <h1>THE SKY<br /><em>BROTHERHOOD.</em></h1>
        <p class="hero-subtitle">HERITAGE STREETWEAR FOR<br />THE AIRBORNE COMMUNITY</p>
        <div class="hero-rule"></div>
        <a class="gold-button" href="/collection/">SHOP THE COLLECTION <b>→</b></a>
        <p class="hero-footnote">PAST · PRESENT · FUTURE</p>
      </div>
      <div class="hero-side-note">BUILT ON BELONGING · EST. IN SPIRIT</div>
      <div class="hero-index">CHAPTER 01 <span>／</span> THE FIRST DROP</div>
    </section>

    <section class="values-strip" aria-label="Our brand values">
      <article><span class="value-symbol parachute-symbol" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M4 20C5 10 12 4 24 4s19 6 20 16c-3 2-6 2-9 0-4 3-8 3-11 0-4 3-8 3-11 0-3 2-6 2-9 0Z"/><path d="M4 20l20 22 20-22M10 20l14 22 14-22M17 20l7 22 7-22M24 4v38"/></svg></span><div><h2>AIRBORNE HERITAGE</h2><p>Inspired by the airborne brotherhood</p></div></article>
      <article><span class="value-symbol" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="m24 5 20 10-20 10L4 15 24 5Z"/><path d="m4 24 20 10 20-10M4 33l20 10 20-10"/></svg></span><div><h2>PREMIUM QUALITY</h2><p>Built for comfort and durability</p></div></article>
      <article><span class="value-symbol" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="12" r="7"/><circle cx="9" cy="18" r="5"/><circle cx="39" cy="18" r="5"/><path d="M11 42v-5c0-8 5-13 13-13s13 5 13 13v5H11ZM2 40v-4c0-6 3-10 9-11M46 40v-4c0-6-3-10-9-11"/></svg></span><div><h2>GLOBAL COMMUNITY</h2><p>For paratroopers, veterans and supporters</p></div></article>
      <article><span class="value-symbol infinity" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 24c-8-11-15-13-19-7-5 8 5 19 13 12l17-14c7-6 15 3 10 11-4 7-11 4-21-2Z"/></svg></span><div><h2>MORE THAN CLOTHING</h2><p>A shared identity and way of life</p></div></article>
    </section>

    <section class="featured" id="collection">
      <div class="section-heading"><span></span><h2>FEATURED COLLECTION</h2><span></span></div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class={`category-card category-card--${category.number}`} href="/collection/">
            <img class="category-photo" src={category.image} alt={category.name + " apparel preview"} loading="lazy" />
            <span class="category-shade"></span>
            <span class="category-number">{category.number}</span>
            <span class="category-caption"><span><b>{category.name}</b><small>{category.note}</small></span><strong>→</strong></span>
          </a>
        ))}
      </div>
      <p class="preview-note"><span>✳</span> FIRST-CHAPTER PREVIEW · GARMENT PHOTOGRAPHY IS FOR CATEGORY PRESENTATION; FINAL PRINT AND EMBROIDERY MOCKUPS WILL BE SHOWN BEFORE LAUNCH.</p>
      <a class="all-collection" href="/collection/">EXPLORE THE FIRST COLLECTION <span>↗</span></a>
    </section>

    <section class="country-chapters" id="countries">
      <div class="section-heading"><span></span><h2>FIVE COUNTRIES. ONE SKY.</h2><span></span></div>
      <p class="country-intro">Explore airborne heritage from across the world. Every chapter carries its own story, connected by the AirBorneSoldier identity.</p>
      <div class="country-grid">
        {countryCollections.map((chapter) => (
          <a class="country-card" href={"/collection/" + chapter.slug + "/"}>
            <img src={chapter.image} alt={chapter.country + " collection preview"} loading="lazy" />
            <span class="country-card-shade"></span>
            <span class="country-card-copy"><small>{chapter.label}</small><b>{chapter.flag} {chapter.country}</b><em>EXPLORE CHAPTER ↗</em></span>
          </a>
        ))}
      </div>
      <p class="country-disclaimer">HERITAGE-INSPIRED CONCEPTS · OFFICIAL INSIGNIA SUBJECT TO COMMERCIAL PERMISSION</p>
    </section>

    <section class="story" id="story">
      <div class="story-image" role="img" aria-label="Airborne training and parachute heritage"></div>
      <div class="story-panel">
        <p class="eyebrow">MORE THAN A MARK</p>
        <h2>ONE SKY.<br /><em>ONE BROTHERHOOD.</em></h2>
        <p>Different countries. Different generations. A shared understanding of what it means to step forward, trust the people beside you and carry yourself with purpose.</p>
        <p>AirBorneSoldier is an independent heritage streetwear brand inspired by the global airborne community — past, present and future.</p>
        <a href="#journal" class="story-link">DISCOVER OUR STORY <span>↗</span></a>
      </div>
    </section>

    <section class="closing" id="journal">
      <p class="eyebrow">THE FIRST CHAPTER STARTS HERE</p>
      <h2>BUILT ON BELONGING.</h2>
      <p>Not just what you wear. A standard you carry.</p>
      <a class="gold-button" href="mailto:valskermsoldaat@gmail.com?subject=AirBorneSoldier%20early%20access">GET EARLY ACCESS <b>→</b></a>
    </section>
  </main>

  <footer class="footer">
    <a class="footer-brand" href="/"><img src={logo} alt="AirBorneSoldier" /></a>
    <p>THE SKY BROTHERHOOD · HERITAGE STREETWEAR</p>
    <div><a href="/collection/">COLLECTION</a><a href="#story">OUR STORY</a><a href="mailto:valskermsoldaat@gmail.com">CONTACT</a></div>
    <small>© {new Date().getFullYear()} AIRBORNESOLDIER. ALL RIGHTS RESERVED.</small>
  </footer>

<style>
/* AirBorneSoldier master visual direction: charcoal, black and antique gold */
:root{--paper:#171914;--paper-deep:#20221d;--ink:#f3eee3;--gold:#d0ad70;--gold-dark:#9b7439;--muted:#b7ae9e}
body{background:#171914;color:#f3eee3}
.topline{background:#171914;color:#e4c486;border-bottom:1px solid #92703d}
.topline-rule{background:#b9904d}
.masthead{background:#171914;border-bottom:1px solid #8b6d3b}
.brand img{mix-blend-mode:normal;filter:none}
.main-nav a{color:#eee8dc}
.main-nav a.active:after{background:#caa363}
.header-cta{background:linear-gradient(110deg,#e5c783,#b58a45);border-color:#e4c783}
.hero{min-height:560px;height:min(680px,64vw);background:#171914}
.hero-photo{background-image:url("https://media.defense.gov/2009/May/12/2001996945/1088/820/0/712156-Q-NRH68-499.jpg");background-position:center 43%;filter:saturate(.72) contrast(1.12)}
.hero-overlay{background:linear-gradient(90deg,rgba(9,12,11,.92),rgba(9,12,11,.72) 36%,rgba(9,12,11,.14) 78%),linear-gradient(0deg,rgba(9,12,11,.42),transparent 45%)}
.hero h1{color:#f5f0e6}
.hero h1 em{color:#d9b979}
.hero-subtitle{color:#eee8dc}
.hero-footnote,.hero-index{color:#e0d4bd}
.values-strip{background:#20221d;color:#f1eadc;border-color:#655438}
.values-strip article{border-color:#655438}
.values-strip h2{color:#f3eee3}
.values-strip p{color:#bdb5a6}
.value-symbol{color:#d2ad6e}
.value-symbol svg{width:43px;height:43px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.featured{background:#171914;color:#f3eee3}
.section-heading h2{color:#eadcc0}
.section-heading span{background:#a98248}
.category-card{border:1px solid #a98248}
.category-shade{background:linear-gradient(180deg,#0b0c0a33 0%,#0b0c0a10 32%,#0b0c0ad9 100%)}
.category-caption small{color:#d8cdb8}
.preview-note{color:#b7ae9e}
.all-collection{color:#e1c58e;border-color:#a98248}
.country-chapters{padding:55px 5.5% 70px;background:#20221d;color:#f3eee3}
.country-intro{max-width:720px;text-align:center;margin:0 auto 30px;color:#c5bcad;font:16px/1.7 Georgia,serif}
.country-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.country-card{height:270px;position:relative;overflow:hidden;border:1px solid #9b7439;background:#34362f}
.country-card img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.7) contrast(1.05)}
.country-card-shade{position:absolute;inset:0;background:linear-gradient(0deg,#090a08ed,transparent 70%)}
.country-card-copy{position:absolute;left:13px;right:13px;bottom:15px;display:flex;flex-direction:column;gap:7px;color:#f5eee0}
.country-card-copy small{font-size:8px;letter-spacing:2px;color:#d8b979}
.country-card-copy b{font-size:14px;letter-spacing:1px}
.country-card-copy em{font-style:normal;font-size:8px;letter-spacing:1.5px;color:#d7c7a9}
.country-disclaimer{text-align:center;font-size:8px;letter-spacing:1.5px;color:#aaa08e;margin:22px 0 0}
.story{background:#171914;color:#f3eee3}
.story-panel p:not(.eyebrow){color:#c5bcad}
.story-link{color:#e1c58e;border-color:#a98248}
.closing{background:#272820;color:#f3eee3}
.closing .eyebrow{color:#d1ad70}
.closing>p:not(.eyebrow){color:#d0c7b7}
.footer{background:#10120f;border-top:1px solid #80623a;color:#d7d0c4}
.footer>p{color:#b7ae9e}
.footer small{border-color:#ffffff25;color:#a49c8d}
@media(max-width:900px){.country-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.country-card{height:240px}}
@media(max-width:760px){.hero{height:560px}.country-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.country-card{height:235px}.values-strip{background:#20221d}.featured{background:#171914}}
@media(max-width:420px){.country-grid{grid-template-columns:1fr 1fr}.country-card{height:205px}.country-card-copy b{font-size:12px}}
</style>

</body>
</html>

<style>
:root{--paper:#f1ede4;--paper-deep:#e8e1d4;--ink:#171914;--gold:#c5a36b;--gold-dark:#8e6b36;--muted:#756f63}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.topline{height:42px;background:#b89b69;color:#171914;display:flex;align-items:center;justify-content:center;gap:18px;padding:0 20px;font-size:11px;font-weight:800;letter-spacing:4px;text-align:center}
.topline-rule{height:1px;width:clamp(25px,7vw,90px);background:#171914}
.topline-star{font-size:15px;margin:0 5px}
.topline-markets{white-space:nowrap}
.masthead{height:140px;background:#f4f0e8;display:flex;align-items:center;justify-content:space-between;padding:8px clamp(24px,5.5vw,86px);gap:26px;border-bottom:1px solid #d9d0c1;position:relative;z-index:3}
.brand{display:flex;align-items:center;flex:0 1 390px;min-width:240px}
.brand img{display:block;width:100%;max-width:390px;max-height:126px;object-fit:contain;object-position:left center;mix-blend-mode:multiply;filter:contrast(1.18) saturate(1.08)}
.main-nav{display:flex;align-items:center;justify-content:center;gap:clamp(16px,3vw,44px);flex:1}
.main-nav a{font-size:12px;font-weight:700;letter-spacing:1.1px;white-space:nowrap;padding:14px 0;position:relative}
.main-nav a.active:after{content:"";position:absolute;bottom:4px;left:0;right:0;height:3px;background:var(--gold-dark)}
.chevron{font-size:17px;margin-left:7px}
.header-cta{display:inline-flex;align-items:center;gap:16px;white-space:nowrap;padding:14px 18px;border:1px solid #9b7130;background:linear-gradient(110deg,#f0d69a,#c69b50);color:#171914;font-size:10px;font-weight:800;letter-spacing:1.2px}
.header-cta span{font-size:17px}
.mobile-collection{display:none}
.hero{min-height:510px;height:min(610px,60vw);position:relative;overflow:hidden;background:#1d2525;color:#fff;display:flex;align-items:center}
.hero-photo{position:absolute;inset:0;background-image:url("https://media.defense.gov/2009/May/12/2001996945/1088/820/0/712156-Q-NRH68-499.jpg");background-size:cover;background-position:center 53%;filter:saturate(.83) contrast(1.08)}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,17,20,.94) 0%,rgba(9,17,20,.82) 30%,rgba(9,17,20,.25) 68%,rgba(9,17,20,.08) 100%),linear-gradient(0deg,rgba(9,17,20,.2),transparent 35%)}
.hero-copy{position:relative;z-index:1;margin-left:9.2%;max-width:620px;padding:54px 0}
.eyebrow{font-size:14px;font-weight:800;letter-spacing:7px;color:#d8b77b;margin:0 0 24px}
.eyebrow span{display:none}
.hero h1{font-size:clamp(54px,6.2vw,91px);line-height:.94;letter-spacing:-3.8px;margin:0 0 24px;font-weight:900;color:#f8f6f0}
.hero h1 em{font-style:normal;color:#d7b675}
.hero-subtitle{font-size:17px;font-weight:700;line-height:1.65;letter-spacing:5px;color:#f1eee6;margin:0}
.hero-rule{width:80px;height:1px;background:#d1ad70;margin:24px 0 20px}
.gold-button{min-width:325px;display:inline-flex;align-items:center;justify-content:space-between;gap:26px;padding:16px 22px;background:linear-gradient(110deg,#d9b978,#a87935);border:1px solid #e7c987;color:#171914;font-size:14px;font-weight:800;letter-spacing:1.3px;box-shadow:0 5px 18px #0003;transition:transform .2s,filter .2s}
.gold-button:hover{transform:translateY(-2px);filter:brightness(1.08)}
.gold-button b{font-size:23px;line-height:1}
.hero-footnote{font-size:9px;letter-spacing:3px;color:#d8d1c4;margin:23px 0 0}
.hero-side-note{position:absolute;right:3.5%;top:48%;writing-mode:vertical-rl;font-size:9px;letter-spacing:3px;color:#ffffffb0}
.hero-index{position:absolute;right:7%;bottom:25px;font-size:9px;letter-spacing:2px;color:#f2e9d8}
.hero-index span{color:#d5b476;padding:0 8px}
.values-strip{display:grid;grid-template-columns:repeat(4,1fr);background:#f4f0e8;padding:24px 7%;border-bottom:1px solid #ded5c7}
.values-strip article{display:flex;align-items:center;gap:18px;padding:5px 22px;border-right:1px solid #cfc5b4;min-width:0}
.values-strip article:first-child{padding-left:0}
.values-strip article:last-child{border:0;padding-right:0}
.value-symbol{font-family:Georgia,serif;font-size:42px;line-height:1;color:#76551f;min-width:42px;text-align:center}
.infinity{font-size:48px}
.values-strip h2{font-size:14px;font-weight:900;margin:0 0 6px;white-space:nowrap}
.values-strip p{font-size:13px;line-height:1.35;margin:0;color:#38372f;max-width:220px}
.featured{padding:36px 5.5% 58px;background:#f2eee6}
.section-heading{display:flex;align-items:center;justify-content:center;gap:30px;margin:0 0 28px}
.section-heading span{height:1px;width:118px;background:#b68b48}
.section-heading h2{font-size:22px;letter-spacing:7px;margin:0;font-weight:900;text-align:center}
.category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.category-card{height:300px;position:relative;overflow:hidden;background:#393a32;color:#fff;display:block}
.category-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s}
.category-card:hover .category-photo{transform:scale(1.045)}
.category-shade{position:absolute;inset:0;background:linear-gradient(180deg,#1114 0%,#1110 35%,#111c 100%)}
.category-brand{position:absolute;width:48%;max-height:118px;object-fit:contain;left:50%;top:48%;transform:translate(-50%,-50%);filter:drop-shadow(0 2px 4px #000b);mix-blend-mode:normal;opacity:1;z-index:2;pointer-events:none}
.category-card--01 .category-brand{width:43%;left:51%;top:48%}
.category-card--02 .category-brand{width:34%;left:58%;top:43%}
.category-card--03 .category-brand{width:56%;left:50%;top:51%}
.category-card--04 .category-brand{width:32%;left:67%;top:43%}
.category-shade{z-index:1}
.category-number{z-index:3}
.category-caption{z-index:3}
.category-number{position:absolute;top:14px;right:15px;font-size:9px;letter-spacing:2px;color:#fff}
.category-caption{position:absolute;left:20px;right:18px;bottom:17px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px}
.category-caption b{display:block;font-size:19px;letter-spacing:2px}
.category-caption small{display:block;font-size:10px;color:#e5dfd3;margin-top:5px}
.category-caption strong{font-size:32px;font-weight:400;line-height:.9}
.preview-note{text-align:center;color:#777064;font-size:9px;letter-spacing:1.8px;line-height:1.6;margin:27px auto 18px}
.preview-note span{color:#a57d3e;margin-right:8px}
.all-collection{display:block;width:max-content;margin:0 auto;color:#5f4a2b;border-bottom:1px solid #a9854c;padding:7px 0;font-size:10px;font-weight:800;letter-spacing:2px}
.all-collection span{margin-left:18px}
.story{display:grid;grid-template-columns:1.05fr .95fr;min-height:440px;background:#1d211e;color:#f2eee6}
.story-image{background-image:url("https://d1ldvf68ux039x.cloudfront.net/thumbs/photos/2312/8165694/1000w_q95.jpg");background-size:cover;background-position:center;min-height:440px}
.story-panel{padding:70px clamp(35px,7vw,110px);display:flex;flex-direction:column;justify-content:center;align-items:flex-start}
.story-panel .eyebrow{font-size:10px;letter-spacing:4px;margin-bottom:20px}
.story-panel h2{font-size:clamp(36px,4vw,57px);line-height:1.02;letter-spacing:-1.5px;margin:0 0 23px}
.story-panel h2 em{font-family:Georgia,serif;font-weight:400;color:#d2ae70}
.story-panel p:not(.eyebrow){font:15px/1.75 Georgia,serif;color:#d2cec3;max-width:520px;margin:0 0 14px}
.story-link{margin-top:14px;font-size:10px;font-weight:800;letter-spacing:2px;border-bottom:1px solid #c5a36b;padding-bottom:9px}
.story-link span{color:#d2ae70;margin-left:18px}
.closing{text-align:center;padding:72px 20px;background:#e4dccd}
.closing .eyebrow{font-size:10px;letter-spacing:4px;color:#876839;margin-bottom:16px}
.closing h2{font-size:clamp(32px,4vw,52px);letter-spacing:3px;margin:0 0 13px}
.closing>p:not(.eyebrow){font:17px Georgia,serif;color:#5f594e;margin:0 0 25px}
.closing .gold-button{min-width:270px}
.footer{background:#171914;color:#d7d0c4;padding:26px 7% 20px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap}
.footer-brand{width:185px;display:block}
.footer-brand img{width:100%;max-height:65px;object-fit:contain;filter:none}
.footer>p{font-size:9px;letter-spacing:2px;color:#bcb4a5}
.footer>div{display:flex;gap:23px}
