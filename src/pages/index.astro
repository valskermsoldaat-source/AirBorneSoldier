.values{background:#e9e5dc;color:#171914}.values .eyebrow{color:#8d7650}.values-heading{margin-bottom:55px}.values-aside{font-size:8px;line-height:1.8;letter-spacing:2px;color:#777165}.values-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #c9c2b4}.value-card{padding:27px 35px 10px 0;border-right:1px solid #c9c2b4;margin-right:35px}.value-card:last-child{border:0;margin:0}.value-card>span{font-size:9px;color:#9c8255;letter-spacing:2px}.value-card h3{font:30px Georgia,serif;margin:25px 0 12px}.value-card p{max-width:270px;color:#686257;font:14px/1.7 Georgia,serif}
