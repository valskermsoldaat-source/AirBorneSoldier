.hero{min-height:690px;height:min(820px,calc(100svh - 116px));position:relative;overflow:hidden;display:flex;align-items:center;padding:7% 12%;background:#20221c}.hero-image{position:absolute;inset:0;background-image:url("https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=2200&q=90");background-position:center 42%;background-size:cover;opacity:.68;filter:saturate(.72) contrast(1.08)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#151712f2 0%,#171914cf 34%,#17191455 70%,#17191420 100%),linear-gradient(0deg,#17191485,transparent 48%)}.hero-content{position:relative;z-index:1;max-width:720px}.eyebrow{font-size:8px;letter-spacing:3px;color:#c7ad81;font-weight:700}.eyebrow i{display:inline-block;width:24px;height:1px;background:#c7ad81;vertical-align:middle;margin-right:10px}
.hero h1{color:#f3efe6;text-shadow:0 3px 24px #0009;font-size:clamp(66px,9.4vw,140px);line-height:.84;letter-spacing:-8px;margin:32px 0 29px;font-weight:900}.hero h1 em,.section-top h2 em,.manifesto h2 em,.closing h2 em{font-family:Georgia,serif;font-weight:400;color:#c7ad81;letter-spacing:-5px}.hero-copy{font:20px/1.55 Georgia,serif;color:#d2cec4;margin-bottom:34px}.hero-actions{display:flex;align-items:center;gap:28px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;padding:17px 19px;font-size:8px;letter-spacing:1.8px;font-weight:700;transition:.2s}.button span{font-size:16px}.button-light{background:#c7ad81;color:#171914;border:1px solid #c7ad81}.button-light:hover{background:#e0d0ae}.text-link{font-size:8px;letter-spacing:1.5px;color:#e2ded4;border-bottom:1px solid #c7ad81;padding:0 0 8px}
.hero-caption{position:absolute;bottom:28px;left:7%;right:7%;display:flex;justify-content:space-between;color:#d3cfc4;font-size:8px;letter-spacing:2px}.hero-caption span:first-child{color:#c7ad81}.vertical-note{position:absolute;right:4%;top:45%;writing-mode:vertical-rl;color:#d4d0c766;font-size:8px;letter-spacing:3px}
.intro-band{position:relative;padding:83px 12%;background:#e9e5dc;color:#171914;text-align:center}.intro-kicker{font-size:8px;letter-spacing:2.5px;color:#81704f}.intro-kicker span{color:#b79b6c;padding:0 10px}.intro-band>p{font:clamp(29px,4.2vw,54px)/1.22 Georgia,serif;letter-spacing:-1.8px;margin:25px 0 0}.intro-band>p em{color:#8d7650}.intro-seal{position:absolute;right:8%;bottom:25px;color:#a48b60;font:17px Georgia,serif;border:1px solid #b8a27d;padding:10px}
