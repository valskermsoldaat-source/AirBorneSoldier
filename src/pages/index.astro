---
import "../styles/global.css";
import { products } from "../data/products";

const values = [
 {number:"01",title:"Belonging",text:"A shared spirit. A place in the brotherhood. No noise, no posturing."},
 {number:"02",title:"Resilience",text:"Made for the long road. The quiet discipline to keep moving forward."},
 {number:"03",title:"Integrity",text:"Say less. Stand by it. Let the standard speak for itself."}
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="AirBorneSoldier — Sky Brotherhood. Premium heritage streetwear built on belonging, resilience and quiet confidence." />
<meta name="theme-color" content="#171914" /><meta property="og:title" content="AirBorneSoldier — Sky Brotherhood" /><meta property="og:description" content="A shared spirit. A higher standard. Discover the Sky Brotherhood." />
<title>AirBorneSoldier® — Sky Brotherhood</title>
</head>
<body>
<div class="announcement">THE SKY BROTHERHOOD — BUILT ON BELONGING <span>✳</span> UK · EUROPE · USA</div>
<header class="site-header">
<a class="wordmark" href="/" aria-label="AirBorneSoldier home"><img class="brand-image" src="/images/airbornesoldier-logo.jpg" alt="AirBorneSoldier — The Sky Brotherhood" /></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="/collection/">Collection</a><a href="#philosophy">Our code</a><a href="#story">The brotherhood</a></nav>
<a class="header-cta" href="mailto:valskermsoldaat@gmail.com?subject=AirBorneSoldier%20early%20access">GET EARLY ACCESS <span>↗</span></a>
</header>
<main>
<section class="hero"><div class="hero-image" role="img" aria-label="Premium streetwear editorial"></div><div class="hero-shade"></div>
<div class="hero-content"><p class="eyebrow"><i></i> SKY BROTHERHOOD · EST. IN SPIRIT</p><h1>BUILT ON<br /><em>BELONGING.</em></h1><p class="hero-copy">Not just what you wear.<br />A standard you carry.</p>
<div class="hero-actions"><a class="button button-light" href="/collection/">EXPLORE THE COLLECTION <span>↘</span></a><a class="text-link" href="#philosophy">DISCOVER OUR CODE</a></div></div>
<div class="hero-caption"><span>01 — 03</span><span>THE FIRST CHAPTER</span></div><div class="vertical-note">AIRBORNE SOLDIER · SKY BROTHERHOOD</div></section>
<section class="intro-band" id="story"><div class="intro-kicker">MORE THAN A MARK <span>／</span> A WAY OF CARRYING YOURSELF</div><p>For those who know that <em>belonging</em><br class="desktop-break" /> is earned through how you live.</p><span class="intro-seal">A／S</span></section>
<section class="featured section-wrap" id="collection"><div class="section-top"><div><p class="eyebrow">THE FIRST CHAPTER</p><h2>FOUNDATIONS<br /><em>OF THE BROTHERHOOD.</em></h2></div><a class="underlined-link" href="/collection/">VIEW THE COLLECTION <span>↗</span></a></div>
<div class="product-grid">{products.map((product,index)=><a class="product-card" href={"/collection/" + products[index].slug + "/"}><div class="product-image"><img src={product.image} alt={product.name} loading="lazy" /><span class="product-tag">{product.tag}</span><span class="product-number">0{index+1}</span><span class="product-quick">VIEW DETAILS ↗</span></div><div class="product-info"><div><h3>{product.name}</h3><p>{product.type}</p></div><span class="price">{product.price}</span></div></a>)}</div>
<p class="drop-note"><span>✳</span> THE FIRST DROP IS IN DEVELOPMENT. JOIN US AT THE START.</p></section>
<section class="manifesto" id="philosophy"><div class="manifesto-image"></div><div class="manifesto-panel"><p class="eyebrow">THE AIRBORNESOLDIER CODE</p><h2>A SHARED SPIRIT.<br /><em>A HIGHER STANDARD.</em></h2><p class="manifesto-copy">Sky Brotherhood is a mark of connection, resilience and quiet confidence. Heritage-inspired pieces, stripped back to what matters. Made to be worn often, kept for longer, and carried with intent.</p><a class="button button-outline" href="mailto:valskermsoldaat@gmail.com?subject=The%20AirBorneSoldier%20Code">GET TO KNOW US <span>↗</span></a></div></section>
<section class="values section-wrap"><div class="section-top values-heading"><div><p class="eyebrow">WHAT WE STAND FOR</p><h2>THE CODE.</h2></div><p class="values-aside">THREE PRINCIPLES.<br />ONE BROTHERHOOD.</p></div><div class="values-grid">{values.map(value=><article class="value-card"><span>{value.number}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></section>
<section class="closing"><p class="eyebrow">YOUR PLACE IS HERE</p><h2>STAND FOR<br /><em>SOMETHING.</em></h2><p>The first chapter is being written. Be part of it.</p><a class="button button-light" href="mailto:valskermsoldaat@gmail.com?subject=Keep%20me%20in%20the%20loop">JOIN THE BROTHERHOOD <span>↗</span></a></section>
</main>
<footer class="site-footer"><a class="footer-brand" href="/">AIRBORNESOLDIER<span>®</span></a><p>PREMIUM HERITAGE STREETWEAR · SKY BROTHERHOOD</p><div class="footer-links"><a href="/collection/">COLLECTION</a><a href="mailto:valskermsoldaat@gmail.com">CONTACT</a></div><small>© {new Date().getFullYear()} AIRBORNESOLDIER. ALL RIGHTS RESERVED.</small></footer>
</body></html>
<style>
.announcement{height:30px;display:flex;align-items:center;justify-content:center;gap:14px;background:#b79b6c;color:#171914;font-size:8px;letter-spacing:2px;font-weight:700}.announcement span{font-size:11px}
.site-header{height:86px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;background:#171914;border-bottom:1px solid #ffffff16;position:relative;z-index:5}.wordmark{display:flex;align-items:center}.brand-image{display:block;width:230px;height:auto;max-height:76px;object-fit:contain;mix-blend-mode:screen;filter:contrast(1.08) brightness(1.06)}
.desktop-nav{display:flex;gap:39px;color:#d4d0c7;font-size:9px;letter-spacing:1.8px;text-transform:uppercase}.desktop-nav a:hover,.footer-links a:hover{color:#c7ad81}.header-cta{border:1px solid #b79b6c;padding:13px 16px;font-size:8px;letter-spacing:1.7px}.header-cta span{color:#c7ad81;margin-left:12px}
.hero{min-height:690px;height:min(820px,calc(100svh - 116px));position:relative;overflow:hidden;display:flex;align-items:center;padding:7% 12%;background:#20221c}.hero-image{position:absolute;inset:0;background-image:url("https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=2200&q=90");background-position:center 42%;background-size:cover;opacity:.52;filter:saturate(.55)}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#151712 0%,#171914ed 35%,#17191465 72%,#17191430 100%),linear-gradient(0deg,#1719149c,transparent 45%)}.hero-content{position:relative;z-index:1;max-width:720px}.eyebrow{font-size:8px;letter-spacing:3px;color:#c7ad81;font-weight:700}.eyebrow i{display:inline-block;width:24px;height:1px;background:#c7ad81;vertical-align:middle;margin-right:10px}
.hero h1{font-size:clamp(66px,9.4vw,140px);line-height:.84;letter-spacing:-8px;margin:32px 0 29px;font-weight:900}.hero h1 em,.section-top h2 em,.manifesto h2 em,.closing h2 em{font-family:Georgia,serif;font-weight:400;color:#c7ad81;letter-spacing:-5px}.hero-copy{font:20px/1.55 Georgia,serif;color:#d2cec4;margin-bottom:34px}.hero-actions{display:flex;align-items:center;gap:28px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;padding:17px 19px;font-size:8px;letter-spacing:1.8px;font-weight:700;transition:.2s}.button span{font-size:16px}.button-light{background:#c7ad81;color:#171914;border:1px solid #c7ad81}.button-light:hover{background:#e0d0ae}.text-link{font-size:8px;letter-spacing:1.5px;color:#e2ded4;border-bottom:1px solid #c7ad81;padding:0 0 8px}
.hero-caption{position:absolute;bottom:28px;left:7%;right:7%;display:flex;justify-content:space-between;color:#d3cfc4;font-size:8px;letter-spacing:2px}.hero-caption span:first-child{color:#c7ad81}.vertical-note{position:absolute;right:4%;top:45%;writing-mode:vertical-rl;color:#d4d0c766;font-size:8px;letter-spacing:3px}
.intro-band{position:relative;padding:83px 12%;background:#e9e5dc;color:#171914;text-align:center}.intro-kicker{font-size:8px;letter-spacing:2.5px;color:#81704f}.intro-kicker span{color:#b79b6c;padding:0 10px}.intro-band>p{font:clamp(29px,4.2vw,54px)/1.22 Georgia,serif;letter-spacing:-1.8px;margin:25px 0 0}.intro-band>p em{color:#8d7650}.intro-seal{position:absolute;right:8%;bottom:25px;color:#a48b60;font:17px Georgia,serif;border:1px solid #b8a27d;padding:10px}
.section-wrap{padding:105px 8%}.featured{background:#171914}.section-top{display:flex;align-items:end;justify-content:space-between;margin-bottom:42px}.section-top h2{font-size:clamp(34px,4.4vw,58px);line-height:.98;letter-spacing:-2.5px;margin:16px 0 0}.section-top h2 em{letter-spacing:-2px}.underlined-link{font-size:8px;letter-spacing:1.8px;border-bottom:1px solid #b79b6c;padding-bottom:9px}.underlined-link span{color:#c7ad81;margin-left:16px}
.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.product-card{min-width:0}.product-image{height:390px;position:relative;overflow:hidden;background:#292c24}.product-image img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.68);transition:transform .65s,filter .65s}.product-card:hover .product-image img{transform:scale(1.045);filter:saturate(.95)}.product-tag,.product-number{position:absolute;top:16px;font-size:7px;letter-spacing:1.6px;color:#f0ece2}.product-tag{left:16px;background:#171914c9;padding:8px 10px}.product-number{right:16px}.product-quick{position:absolute;bottom:0;left:0;right:0;background:#171914df;color:#e9e5dc;text-align:center;padding:15px;font-size:8px;letter-spacing:2px;transform:translateY(100%);transition:transform .25s}.product-card:hover .product-quick{transform:translateY(0)}
.product-info{display:flex;justify-content:space-between;gap:10px;padding:17px 0;border-bottom:1px solid #ffffff2b}.product-info h3{font:18px Georgia,serif;margin:0 0 7px}.product-info p{font-size:9px;color:#aaa69c;margin:0}.price{font-size:11px;color:#c7ad81}.drop-note{text-align:center;margin:38px 0 0;color:#aaa69c;font-size:8px;letter-spacing:2px}.drop-note span{color:#c7ad81;margin-right:8px}
.manifesto{display:grid;grid-template-columns:1fr 1fr;min-height:560px;background:#282a23}.manifesto-image{background:url("https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1300&q=85") center/cover;filter:saturate(.55)}.manifesto-panel{padding:90px 12%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.manifesto h2{font-size:clamp(31px,3.7vw,50px);line-height:1.02;letter-spacing:-2px;margin:22px 0}.manifesto h2 em{letter-spacing:-2px}.manifesto-copy{font:15px/1.85 Georgia,serif;color:#c0bcb1;max-width:420px;margin:0 0 28px}.button-outline{border:1px solid #b79b6c;color:#e9e5dc}.button-outline span{color:#c7ad81}.button-outline:hover{background:#b79b6c;color:#171914}
.values{background:#e9e5dc;color:#171914}.values .eyebrow{color:#8d7650}.values-heading{margin-bottom:55px}.values-aside{font-size:8px;line-height:1.8;letter-spacing:2px;color:#777165}.values-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #c9c2b4}.value-card{padding:27px 35px 10px 0;border-right:1px solid #c9c2b4;margin-right:35px}.value-card:last-child{border:0;margin:0}.value-card>span{font-size:9px;color:#9c8255;letter-spacing:2px}.value-card h3{font:30px Georgia,serif;margin:25px 0 12px}.value-card p{max-width:270px;color:#686257;font:14px/1.7 Georgia,serif}
.closing{padding:110px 12%;background:radial-gradient(ellipse at 50% 0%,#424337,#24261f 58%,#171914);text-align:center}.closing h2{font-size:clamp(55px,7vw,92px);line-height:.9;letter-spacing:-4px;margin:25px 0}.closing>p:not(.eyebrow){font:16px Georgia,serif;color:#c1bdb3;margin:0 0 28px}
.site-footer{padding:30px 7%;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#969287}.footer-brand{font-size:11px;font-weight:800;letter-spacing:2px;color:#e9e5dc}.footer-brand span{color:#c7ad81}.site-footer>p,.site-footer small,.footer-links{font-size:7px;letter-spacing:1.4px}.footer-links{display:flex;gap:20px}.site-footer small{width:100%;border-top:1px solid #ffffff20;padding-top:18px}
@media(max-width:850px){.site-header{padding:0 5%}.desktop-nav{gap:18px}.hero{padding:10% 8%;min-height:620px}.product-image{height:310px}.manifesto-panel{padding:65px 9%}.section-wrap{padding:85px 6%}}
@media(max-width:620px){.announcement{font-size:7px;letter-spacing:1.4px}.site-header{height:72px}.desktop-nav{display:none}.header-cta{font-size:7px;padding:11px}.hero{height:690px;min-height:0;padding:12% 7%}.hero-image{background-position:58% center}.hero-shade{background:linear-gradient(90deg,#151712f5,#171914c9 65%,#17191470)}.hero h1{font-size:clamp(59px,14vw,92px);letter-spacing:-4px}.hero h1 em{letter-spacing:-3px}.hero-copy{font-size:18px}.hero-actions{align-items:flex-start;flex-direction:column;gap:19px}.vertical-note{display:none}.intro-band{padding:75px 7%}.intro-seal{display:none}.desktop-break{display:none}.section-wrap{padding:75px 6%}.section-top{align-items:flex-start;gap:20px;flex-direction:column}.product-grid{grid-template-columns:1fr 1fr;gap:24px 12px}.product-image{height:260px}.product-info h3{font-size:15px}.product-info p{font-size:8px}.product-quick{display:none}.manifesto{grid-template-columns:1fr}.manifesto-image{min-height:300px}.manifesto-panel{padding:70px 8%}.values-grid{grid-template-columns:1fr}.value-card{border-right:0;border-bottom:1px solid #c9c2b4;margin:0;padding:25px 0}.value-card h3{margin:12px 0 8px}.values-heading{margin-bottom:30px}.closing{padding:85px 7%}.site-footer{padding:28px 6%;justify-content:flex-start}.site-footer>p{width:100%;margin:0}.site-footer small{line-height:1.7}}
@media(max-width:390px){.brand-image{width:170px}.header-cta{font-size:6px;letter-spacing:1px}.product-image{height:220px}}

/* AirBorneSoldier light heritage storefront refresh */
.site-header{background:#eeeae1;border-bottom:1px solid #d8d0c1}
.desktop-nav{color:#282820}.desktop-nav a:hover{color:#987a48}
.header-cta{color:#25251f;border-color:#a88b5b}.header-cta span{color:#987a48}
.featured{background:#eeeae1;color:#20211c}
.featured .eyebrow{color:#8d7650}
.section-top h2{color:#20211c}
.section-top h2 em{color:#9a7d4e}
.underlined-link{color:#25251f;border-color:#a88b5b}
.underlined-link span{color:#987a48}
.product-image{background:#d8d2c6}
.product-image img{filter:saturate(.82)}
.product-tag{background:#24251fe8;color:#f5f1e8}
.product-number{color:#25251f;text-shadow:0 1px 5px #eeeae1}
.product-quick{background:#25251feF;color:#f3efe6}
.product-info{border-color:#cfc7b8}
.product-info h3{color:#24251f}
.product-info p{color:#777267}
.price{color:#8d7042}
.drop-note{color:#716b5e}.drop-note span{color:#9a7d4e}
.site-footer{background:#20211c;color:#bdb7aa}
@media(max-width:620px){.site-header{background:#eeeae1}.header-cta{color:#25251f}}

</style>