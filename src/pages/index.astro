---
import "../styles/global.css";
import { countries, garmentCategories } from "../data/products";
const logo = "/images/airbornesoldier-logo.svg";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="AirBorneSoldier — The Sky Brotherhood. Premium airborne heritage streetwear, built on belonging." />
  <meta name="theme-color" content="#171914" />
  <title>AirBorneSoldier® — The Sky Brotherhood</title>
</head>
<body>
  <div class="announcement">THE SKY BROTHERHOOD <span>—</span> BUILT ON BELONGING</div>
  <header class="site-header">
    <a class="brand" href="/" aria-label="AirBorneSoldier home"><img src={logo} alt="AirBorneSoldier" /></a>
    <nav aria-label="Main navigation"><a class="current" href="/">Home</a><a href="/collection/">Collection</a><a href="#story">Our story</a><a href="mailto:valskermsoldaat@gmail.com">Contact</a></nav>
    <a class="nav-cta" href="/collection/">Explore collection <span>↗</span></a>
  </header>
  <main>
    <section class="hero">
      <div class="hero-art" aria-hidden="true"><div class="sun"></div><div class="ridge ridge-back"></div><div class="ridge ridge-front"></div><div class="canopy canopy-one"><i></i></div><div class="canopy canopy-two"><i></i></div></div>
      <div class="hero-content"><p class="kicker">AIRBORNESOLDIER® · EST. IN SPIRIT</p><h1>THE SKY<br /><em>BROTHERHOOD.</em></h1><p class="hero-sub">HERITAGE STREETWEAR FOR THE AIRBORNE COMMUNITY</p><a class="gold-button" href="/collection/">SHOP THE COLLECTION <b>↗</b></a><p class="hero-foot">PAST · PRESENT · FUTURE</p></div>
      <div class="hero-caption">ONE SKY. MANY STORIES.</div>
    </section>
    <section class="values" aria-label="Brand values">
      <article><span>01</span><div><h2>Airborne heritage</h2><p>Inspired by the people and stories</p></div></article>
      <article><span>02</span><div><h2>Premium quality</h2><p>Considered design, made to wear</p></div></article>
      <article><span>03</span><div><h2>Global community</h2><p>Five chapters, one shared identity</p></div></article>
      <article><span>04</span><div><h2>More than clothing</h2><p>A brotherhood built on belonging</p></div></article>
    </section>
    <section class="section categories" id="collection">
      <div class="section-head"><p class="kicker">THE FIRST EDITION</p><h2>THE COLLECTION</h2><p>Four essentials. One unmistakable identity.</p></div>
      <div class="category-grid">{garmentCategories.map((item) => <a class="category" href={"/collection/#" + item.slug}><span class="category-no">{item.number}</span><div class={"garment-art art-" + item.slug}><span>{item.name.toUpperCase()}</span></div><div class="category-meta"><div><h3>{item.name}</h3><p>{item.note}</p></div><b>↗</b></div></a>)}</div>
      <p class="preview-note">GARMENT CONCEPTS ARE IN DEVELOPMENT. FINAL PRODUCT PHOTOGRAPHY, SUPPLIER DETAILS AND SPECIFICATIONS WILL BE PUBLISHED BEFORE SALES OPEN.</p>
      <a class="text-link" href="/collection/">EXPLORE THE FIRST COLLECTION ↗</a>
    </section>
    <section class="section chapters">
      <div class="section-head"><p class="kicker">FIVE DISTINCT AIRBORNE STORIES</p><h2>ONE SKY. FIVE CHAPTERS.</h2><p>Independent country collections, connected by a shared airborne heritage.</p></div>
      <div class="country-grid">{countries.map((country) => <a class="country" href={"/collection/" + country.slug + "/"}><span class="country-number">CHAPTER {country.chapter}</span><span class="country-flag">{country.flag}</span><h3>{country.country}</h3><p>{country.region}</p><b>EXPLORE CHAPTER ↗</b></a>)}</div>
    </section>
    <section class="story" id="story"><div><p class="kicker">MORE THAN A MARK</p><h2>ONE SKY.<br /><em>ONE BROTHERHOOD.</em></h2></div><div><p>Different countries. Different generations. A shared understanding of trust, courage, discipline and belonging.</p><p>AirBorneSoldier is an independent heritage streetwear brand inspired by the global airborne community — past, present and future.</p><a class="text-link" href="/collection/">DISCOVER THE CHAPTERS ↗</a></div></section>
    <section class="closing"><p class="kicker">THE FIRST CHAPTER STARTS HERE</p><h2>BUILT ON BELONGING.</h2><p>Not just what you wear. A standard you carry.</p><a class="gold-button" href="mailto:valskermsoldaat@gmail.com?subject=AirBorneSoldier%20early%20access">GET EARLY ACCESS ↗</a></section>
  </main>
  <footer class="footer"><a href="/"><img src={logo} alt="AirBorneSoldier" /></a><p>THE SKY BROTHERHOOD · HERITAGE STREETWEAR</p><div><a href="/collection/">COLLECTION</a><a href="#story">OUR STORY</a><a href="mailto:valskermsoldaat@gmail.com">CONTACT</a></div><small>© {new Date().getFullYear()} AIRBORNESOLDIER. ALL RIGHTS RESERVED.</small></footer>
<style>
:root{--ink:#f2eee4;--night:#171914;--panel:#22251e;--gold:#c7a66e;--muted:#b8b1a3}*{box-sizing:border-box}body{margin:0;background:var(--night);color:var(--ink);font-family:Arial,Helvetica,sans-serif}a{color:inherit;text-decoration:none}.announcement{height:34px;display:flex;align-items:center;justify-content:center;gap:12px;background:#b89a68;color:#171914;font-size:9px;font-weight:800;letter-spacing:3px}.site-header{height:108px;padding:10px 6%;display:flex;align-items:center;justify-content:space-between;gap:25px;background:#f1ede4;color:#171914;border-bottom:1px solid #cbbd9f}.brand img{display:block;width:275px;max-height:84px;object-fit:contain}.site-header nav{display:flex;gap:32px}.site-header nav a{font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.site-header nav a:hover,.site-header nav .current{color:#987440}.nav-cta{padding:14px 18px;background:#c7a66e;color:#171914;font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.nav-cta span{margin-left:15px}.hero{height:min(690px,70vw);min-height:540px;position:relative;overflow:hidden;display:flex;align-items:center;background:linear-gradient(90deg,#11140f 0%,#1d211b 45%,#414239 100%)}.hero-art{position:absolute;inset:0;overflow:hidden;background:radial-gradient(ellipse at 73% 20%,#c8a36b55,transparent 32%),linear-gradient(180deg,#343a35 0%,#77705b 50%,#292c25 100%)}.sun{position:absolute;width:340px;height:340px;border-radius:50%;background:#d4ae72;filter:blur(2px);right:17%;top:8%;opacity:.7}.ridge{position:absolute;bottom:-5%;width:120%;height:56%;clip-path:polygon(0 75%,13% 43%,24% 68%,38% 17%,51% 65%,67% 29%,82% 67%,100% 35%,100% 100%,0 100%)}.ridge-back{background:#3e4438;opacity:.9}.ridge-front{height:43%;background:#1b211b;opacity:.94;transform:translateX(-5%)}.canopy{position:absolute;top:18%;right:22%;width:125px;height:55px;border-radius:90px 90px 15px 15px;background:repeating-conic-gradient(from 0deg at 50% 100%,#d6c39d 0deg 17deg,#8d7955 18deg 19deg);clip-path:ellipse(50% 50% at 50% 50%);opacity:.9}.canopy:after{content:"";position:absolute;top:47px;left:50%;height:145px;border-left:1px solid #e4d7bc;box-shadow:-38px 0 #e4d7bc,38px 0 #e4d7bc,-18px 0 #e4d7bc,18px 0 #e4d7bc}.canopy-two{top:30%;right:8%;transform:scale(.58);opacity:.65}.hero-content{position:relative;z-index:2;margin-left:10%;max-width:620px}.kicker{font-size:10px;font-weight:800;letter-spacing:4px;color:var(--gold)}.hero h1{font-size:clamp(54px,7vw,96px);line-height:.91;letter-spacing:-4px;margin:23px 0;color:#fff}.hero h1 em,.story h2 em{font-family:Georgia,serif;font-weight:400;color:#d6b77f}.hero-sub{font-size:13px;line-height:1.8;letter-spacing:3px;font-weight:700;max-width:400px}.gold-button{display:inline-flex;justify-content:space-between;gap:38px;min-width:260px;padding:17px 19px;margin-top:20px;background:linear-gradient(110deg,#e0c58f,#b78c4b);color:#171914;font-size:10px;font-weight:900;letter-spacing:1.3px}.hero-foot{font-size:9px;letter-spacing:3px;color:#d2c7b4;margin-top:24px}.hero-caption{position:absolute;right:5%;bottom:28px;font-size:9px;letter-spacing:3px;color:#eee3ce}.values{display:grid;grid-template-columns:repeat(4,1fr);padding:25px 6%;background:#22251e;border-block:1px solid #6d5b3e}.values article{display:flex;align-items:center;gap:15px;padding:5px 18px;border-right:1px solid #66583e}.values article:last-child{border:0}.values article>span{font:22px Georgia;color:var(--gold)}.values h2{font-size:12px;letter-spacing:1px;margin:0 0 6px}.values p{font:12px Georgia;color:var(--muted);margin:0}.section{padding:75px 6%}.categories{background:#171914}.section-head{text-align:center;margin-bottom:34px}.section-head h2{font-size:clamp(27px,4vw,42px);letter-spacing:5px;margin:10px 0}.section-head>p:last-child{font:16px Georgia;color:var(--muted)}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.category{position:relative;background:#262920;border:1px solid #74603e;padding:13px;min-height:340px}.category-no{font-size:9px;color:var(--gold);letter-spacing:2px}.garment-art{height:230px;margin:12px 0;background:radial-gradient(ellipse at 50% 40%,#65665a,#292d25 65%,#1b1e19);display:grid;place-items:center;overflow:hidden}.garment-art:before{content:"";width:120px;height:165px;background:linear-gradient(110deg,#191b18,#3d4038,#171915);clip-path:polygon(22% 0,38% 0,50% 8%,62% 0,78% 0,100% 24%,83% 38%,74% 27%,76% 100%,24% 100%,26% 27%,17% 38%,0 24%);filter:drop-shadow(0 12px 10px #0008)}.art-hoodies:before{width:130px;height:175px;clip-path:polygon(25% 10%,35% 0,65% 0,75% 10%,100% 24%,84% 40%,75% 30%,78% 100%,22% 100%,25% 30%,16% 40%,0 24%)}.art-sweatshirts:before{background:linear-gradient(110deg,#65665d,#9a988a,#4c4e46)}.art-caps:before{width:145px;height:85px;border-radius:75px 75px 15px 15px;clip-path:polygon(0 60%,12% 20%,40% 0,80% 10%,100% 60%,65% 75%,30% 100%);background:linear-gradient(110deg,#30352d,#777668,#252920)}.garment-art>span{position:absolute;font-size:8px;letter-spacing:3px;color:#d4c39e}.category-meta{display:flex;justify-content:space-between;align-items:center}.category-meta h3{font-size:17px;margin:0 0 4px}.category-meta p{font:12px Georgia;color:var(--muted);margin:0}.category-meta>b{font-size:24px;color:var(--gold)}.preview-note{text-align:center;color:#aaa18f;font-size:8px;letter-spacing:1.4px;line-height:1.8;margin:25px auto;max-width:900px}.text-link{display:block;width:max-content;margin:20px auto 0;color:#e1c58e;font-size:10px;font-weight:800;letter-spacing:2px;border-bottom:1px solid #a98248;padding-bottom:9px}.chapters{background:#22251e}.country-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.country{min-height:260px;padding:22px 18px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;background:linear-gradient(145deg,#414338,#252820 70%);border:1px solid #77603b;transition:transform .2s,border-color .2s}.country:hover{transform:translateY(-4px);border-color:#e1c58e}.country-number,.country>p{font-size:8px;letter-spacing:2px;color:#c4a36d}.country-flag{font-size:32px;margin:22px 0 8px}.country h3{font:24px Georgia;margin:0}.country>p{margin:8px 0 20px}.country>b{font-size:8px;letter-spacing:1.5px;color:#e1c58e}.story{display:grid;grid-template-columns:1fr 1fr;gap:8%;padding:85px 10%;background:#171914}.story h2{font-size:clamp(38px,5vw,62px);line-height:1.05}.story>div:last-child{align-self:center}.story>div:last-child p{font:17px/1.8 Georgia;color:#c8c1b4}.story .text-link{margin:28px 0 0}.closing{text-align:center;padding:75px 20px;background:linear-gradient(120deg,#33352b,#1b1e18);border-top:1px solid #77603b}.closing h2{font-size:clamp(30px,5vw,52px);letter-spacing:4px}.closing>p:not(.kicker){font:16px Georgia;color:#c6beaf}.closing .gold-button{margin-top:15px}.footer{padding:35px 6% 22px;text-align:center;background:#10120f;border-top:1px solid #80623a}.footer img{width:220px;max-height:70px;object-fit:contain}.footer p,.footer small{font-size:8px;letter-spacing:2px;color:#aaa18f}.footer div{display:flex;justify-content:center;gap:30px;margin:25px 0}.footer div a{font-size:9px;letter-spacing:1.5px}.footer small{display:block;border-top:1px solid #ffffff20;padding-top:18px}
@media(max-width:900px){.site-header{padding:10px 4%}.site-header nav{gap:15px}.brand img{width:220px}.values{grid-template-columns:repeat(2,1fr);gap:15px}.values article:nth-child(2){border:0}.country-grid{grid-template-columns:repeat(3,1fr)}.category-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.announcement{font-size:7px;letter-spacing:1.6px}.site-header{height:82px;padding:8px 14px}.brand img{width:175px;max-height:62px}.site-header nav{display:none}.nav-cta{padding:12px;font-size:8px}.hero{height:610px;min-height:610px}.hero-content{margin:0 7%;}.hero h1{font-size:54px;letter-spacing:-2px}.hero-art{background-position:center}.canopy{right:8%;top:14%;transform:scale(.7)}.canopy-two{right:-2%;top:27%}.hero-caption{font-size:7px}.values{padding:22px 5%;gap:12px}.values article{padding:5px 8px;gap:9px}.values h2{font-size:10px}.values p{font-size:10px}.section{padding:55px 5%}.category{padding:9px;min-height:285px}.garment-art{height:185px}.category-meta h3{font-size:15px}.country-grid{grid-template-columns:repeat(2,1fr)}.country{min-height:220px;padding:16px 13px}.country h3{font-size:19px}.story{grid-template-columns:1fr;padding:60px 7%;gap:0}.story h2{font-size:43px}.closing{padding:60px 18px}.footer div{gap:17px;flex-wrap:wrap}}
</style>
</body>
</html>