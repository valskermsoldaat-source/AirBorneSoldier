---
import "../../styles/global.css";
import { products } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={product.description} />
  <meta name="theme-color" content="#171914" />
  <title>{product.name} — AirBorneSoldier®</title>
</head>
<body>
  <div class="topline">THE SKY BROTHERHOOD — BUILT ON BELONGING <span>✳</span> UK · EUROPE · USA</div>
  <header class="header">
    <a class="logo" href="/" aria-label="AirBorneSoldier home"><img class="brand-image" src="https://d2ol7oe51mr4n9.cloudfront.net/user_39LyNd3yWOiGeUhnS3CdfDw25su/c14fa22d-dcdf-4531-ac68-c193884954df.png" alt="AirBorneSoldier — The Sky Brotherhood" /></a>
    <nav><a href="/">HOME</a><a href="/collection/">COLLECTION</a><a href="/#story">OUR STORY</a><a href="mailto:valskermsoldaat@gmail.com">CONTACT</a></nav><a class="header-cta" href="mailto:valskermsoldaat@gmail.com?subject=AirBorneSoldier%20early%20access">SHOP THE COLLECTION <span>→</span></a>
  </header>
  <main>
    <div class="breadcrumbs"><a href="/">HOME</a><span>/</span><a href="/collection/">COLLECTION</a><span>/</span><span>{product.name.toUpperCase()}</span></div>
    <section class="product-layout">
      <div class="gallery">
        <div class="main-image"><img src={product.image} alt={product.name} /></div>
        <p class="image-note">AIRBORNESOLDIER® · THE FIRST EDITION</p>
      </div>
      <div class="product-copy">
        <p class="eyebrow">{product.flag} {product.country.toUpperCase()} · {product.label}</p>
        <h1>{product.name}</h1>
        <p class="price">{product.price}</p>
        <p class="description">{product.description}</p>
        <div class="design-placement"><strong>THE DESIGN APPROACH</strong><span>FRONT CHEST / SHOULDER · AIRBORNESOLDIER MAKER’S MARK</span><span>BACK · COUNTRY AIRBORNE HERITAGE ARTWORK</span></div>
        <div class="rule"></div>
        <div class="option-row"><span>COLOUR</span><strong>{product.colour}</strong></div>
        <div class={"swatch swatch-" + product.slug} aria-label={"Colour: " + product.colour}><span></span>{product.colour}</div>
        <div class="option-row"><span>SIZE</span><span class="muted">Size availability to be confirmed at launch</span></div>
        <div class="size-list" aria-label="Indicative sizes">
          <span>XS</span><span>S</span><span>M</span><span>L</span><span>XL</span><span>XXL</span>
        </div>
        <a class="notify-button" href={"mailto:valskermsoldaat@gmail.com?subject=" + encodeURIComponent("Early access — " + product.name) + "&body=" + encodeURIComponent("Please let me know when " + product.name + " is available.")}>REGISTER INTEREST <b>↗</b></a>
        <p class="availability"><span>✳</span> FIRST EDITION · IN DEVELOPMENT</p>
        <p class="availability-copy">This is a product preview, not an active listing. Final colours, sizes, specifications, pricing and availability will be confirmed before orders open. No payment can be taken on this page.</p>
        <div class="rule"></div>
        <h2 class="details-heading">THE DETAILS</h2>
        <ul>{product.details.map((detail) => <li>{detail}</li>)}</ul>
        <p class="back-link"><a href="/collection/">← BACK TO THE COLLECTION</a></p>
      </div>
    </section>
    <section class="more">
      <p class="eyebrow">CONTINUE EXPLORING</p><h2>THE FIRST EDITION.</h2>
      <div class="related-grid">{related.map((item) => <a href={"/collection/" + item.slug + "/"} class="related-card"><img src={item.image} alt={item.name} loading="lazy" /><span>{item.category}</span><strong>{item.name}</strong></a>)}</div>
    </section>
  </main>
  <footer><a href="/">AIRBORNESOLDIER®</a><span>SKY BROTHERHOOD</span><a href="mailto:valskermsoldaat@gmail.com">CONTACT ↗</a></footer>
</body>
</html>
<style>
.topline{height:30px;background:#b79b6c;color:#171914;display:grid;place-items:center;font-size:8px;letter-spacing:2px;font-weight:700}
.header{height:108px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff20}
.logo{display:flex;align-items:center}.brand-image{display:block;width:290px;height:auto;max-height:96px;object-fit:contain;mix-blend-mode:multiply;filter:contrast(1.55) saturate(1.25) brightness(.78) drop-shadow(0 3px 2px #8b765333);transition:transform .2s ease}.brand-image:hover{transform:scale(1.025)}
.header nav{display:flex;gap:30px;font-size:8px;letter-spacing:1.8px;color:#d1cdc3}
.breadcrumbs{padding:25px 7%;display:flex;gap:12px;font-size:8px;letter-spacing:1.5px;color:#aaa69c}.breadcrumbs span:last-child{color:#c7ad81}
.product-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(340px,.9fr);gap:7%;padding:25px 7% 100px;max-width:1600px;margin:auto}
.main-image{height:min(760px,70vw);min-height:480px;background:#282a23}.main-image img{width:100%;height:100%;object-fit:cover;display:block}.image-note{font-size:8px;letter-spacing:2px;color:#9e998d;padding-top:15px}
.product-copy{padding:35px 0}.eyebrow{font-size:8px;letter-spacing:2.5px;color:#c7ad81}.product-copy h1{font:clamp(42px,5vw,70px)/1 Georgia,serif;letter-spacing:-2px;margin:20px 0}.price{font-size:16px;color:#c7ad81}.description{font:17px/1.7 Georgia,serif;color:#c9c4b9;max-width:510px;margin:25px 0 30px}.rule{height:1px;background:#ffffff30;margin:27px 0}.design-placement{display:flex;flex-direction:column;gap:8px;padding:16px 18px;background:#e7dfd1;border-left:3px solid #b79b6c;color:#514a3e;font-size:9px;letter-spacing:1px}.design-placement strong{color:#8d7042;font-size:9px;letter-spacing:1.7px}.design-placement span{line-height:1.5}.option-row{display:flex;justify-content:space-between;gap:15px;font-size:8px;letter-spacing:1.5px;color:#aaa69c}.option-row strong{color:#e9e5dc;letter-spacing:0;font-size:11px}.muted{letter-spacing:0;text-align:right;font-size:10px}.swatch{display:flex;align-items:center;gap:10px;margin:15px 0 28px;font-size:11px;color:#d2cec4}.swatch span{width:21px;height:21px;border-radius:50%;background:#eeeae1;border:1px solid #aaa69c}
.swatch-brotherhood-hoodie span,.swatch-field-crew span{background:#777b7c}.swatch-field-crew span{background:#171914}.size-list{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin:15px 0 27px}.size-list span{border:1px solid #ffffff35;text-align:center;padding:13px 0;font-size:10px;color:#aaa69c}
.notify-button{display:flex;justify-content:space-between;align-items:center;background:#c7ad81;color:#171914;padding:19px 20px;font-size:9px;font-weight:700;letter-spacing:1.8px}.notify-button b{font-size:16px}.availability{font-size:8px;letter-spacing:1.5px;color:#c7ad81;margin:25px 0 9px}.availability span{margin-right:7px}.availability-copy{font:13px/1.7 Georgia,serif;color:#aaa69c;margin:0}.details-heading{font:20px Georgia,serif}.product-copy ul{padding-left:18px;color:#c5c0b5;font:13px/2 Georgia,serif}.back-link{margin-top:35px;font-size:8px;letter-spacing:1.5px;color:#c7ad81}
.more{background:#e9e5dc;color:#171914;padding:75px 7% 90px}.more .eyebrow{color:#8d7650}.more h2{font:clamp(30px,4vw,48px) Georgia,serif;margin:12px 0 30px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.related-card{display:flex;flex-direction:column;gap:10px}.related-card img{width:100%;height:290px;object-fit:cover}.related-card span{font-size:8px;letter-spacing:1.5px;color:#8d7650;text-transform:uppercase}.related-card strong{font:20px Georgia,serif}
footer{padding:28px 7%;display:flex;justify-content:space-between;border-top:1px solid #ffffff20;color:#aaa69c;font-size:8px;letter-spacing:1.5px}footer a:first-child{color:#e9e5dc;font-weight:800}
@media(max-width:800px){.product-layout{grid-template-columns:1fr;gap:20px;padding:15px 6% 70px}.main-image{height:110vw;min-height:0;max-height:650px}.product-copy{padding:10px 0}.related-card img{height:220px}}
@media(max-width:520px){.header{padding:0 5%;height:72px}.brand-image{width:220px;max-height:76px}.header nav{gap:12px;font-size:7px}.breadcrumbs{padding:20px 5%;font-size:7px}.related-grid{grid-template-columns:1fr 1fr;gap:15px}.related-card img{height:190px}.related-card strong{font-size:16px}footer{padding:25px 5%;font-size:7px}}

/* Light product detail presentation */
body{background:#eeeae1;color:#24251f}
.header{background:#eeeae1;border-bottom:1px solid #d5cdbf}
.header nav{color:#39382f}
.breadcrumbs{color:#777165}
.breadcrumbs span:last-child{color:#8d7042}
.product-layout{background:#eeeae1}
.main-image{background:#ded8cc}
.image-note{color:#777165}
.product-copy .eyebrow{color:#8d7042}
.product-copy h1{color:#24251f}
.price{color:#8d7042}
.description{color:#5f5b52}.design-placement{background:#e7dfd1;color:#514a3e}.design-placement strong{color:#8d7042}
.rule{background:#d0c8b9}
.option-row{color:#716b60}
.option-row strong{color:#292820}
.muted{color:#777165}
.swatch{color:#4f4b43}
.swatch span{border-color:#aaa18f}
.swatch-brotherhood-hoodie span{background:#777b7c}
.swatch-field-crew span{background:#171914}
.size-list span{border-color:#c9c0b1;color:#49463e;background:#f5f2eb}
.notify-button{background:#b79b6c;color:#191a16}
.availability{color:#8d7042}
.availability-copy{color:#6f6a60}
.details-heading{color:#24251f}
.product-copy ul{color:#625d53}
.back-link{color:#8d7042}
.more{background:#e4ded2;color:#24251f}
.more .eyebrow{color:#8d7042}
.related-card span{color:#8d7042}
.related-card strong{color:#24251f}
footer{background:#20211c;border-color:#393a32;color:#c3bdae}
footer a:first-child{color:#f0ece2}


/* Product header matches the master AirBorneSoldier identity */
.header{height:142px!important;min-height:142px!important;background:#171914!important;border-bottom:1px solid #8f7549!important;padding:14px clamp(24px,7vw,100px)!important}
.header .logo{display:flex;align-items:center}
.header .brand-image{display:block;width:370px!important;max-width:38vw;height:auto!important;max-height:118px!important;object-fit:contain;mix-blend-mode:normal!important;filter:none!important;transition:transform .2s ease}
.header .brand-image:hover{transform:scale(1.02)}
.header nav,.header nav a{color:#eeeae1!important}
@media(max-width:760px){.header{height:112px!important;min-height:112px!important;padding:10px 18px!important}.header .brand-image{width:250px!important;max-width:62vw!important;max-height:88px!important}}


.header{height:186px!important;min-height:186px!important;padding:10px clamp(24px,5.5vw,90px)!important;background:#f2eee5!important;border-bottom:1px solid #d6c9b2!important}
.header .logo{width:420px!important;max-width:34vw!important;flex:0 0 420px!important;display:flex;align-items:center}
.header .brand-image{width:100%!important;max-height:166px!important;object-fit:contain!important;mix-blend-mode:normal!important;filter:contrast(1.65) brightness(.86) saturate(1.25)!important}
.header nav,.header nav a{color:#171914!important}
@media(max-width:900px){.header{height:auto!important;min-height:140px!important;padding:12px 4%!important;flex-wrap:wrap!important}.header .logo{flex:0 0 300px!important;width:300px!important;max-width:48vw!important}.header .brand-image{max-height:115px!important}}
@media(max-width:620px){.header{height:112px!important;min-height:112px!important;flex-wrap:nowrap!important;padding:8px 14px!important}.header .logo{width:220px!important;max-width:58vw!important;flex:0 0 220px!important}.header .brand-image{max-height:90px!important}}


/* Logo treatment: transparent outside, solid metallic artwork, no rectangular backing. */
.brand-image{display:block;object-fit:contain!important;mix-blend-mode:normal!important;filter:none!important;opacity:1!important}
</style>

