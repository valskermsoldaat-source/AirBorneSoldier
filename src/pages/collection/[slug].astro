---
import "../../styles/global.css";
import { countries, products } from "../../data/products";
export function getStaticPaths() {
  return countries.map((country) => ({ params: { slug: country.slug }, props: { country } }));
}
const { country } = Astro.props;
const chapterProducts = products.filter((product) => product.countrySlug === country.slug);
const logo = "/images/airbornesoldier-logo.svg";
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={country.intro} /><title>{country.country} Airborne Heritage — AirBorneSoldier®</title></head>
<body>
<div class="announcement">THE SKY BROTHERHOOD <span>—</span> BUILT ON BELONGING</div>
<header class="site-header"><a class="brand" href="/"><img src={logo} alt="AirBorneSoldier" /></a><nav><a href="/">Home</a><a href="/collection/">Collection</a><a href="/#story">Our story</a><a href="mailto:valskermsoldaat@gmail.com">Contact</a></nav><a class="nav-cta" href="/collection/">All chapters ↗</a></header>
<main>
<div class="breadcrumb"><a href="/">HOME</a> / <a href="/collection/">COLLECTION</a> / {country.country.toUpperCase()}</div>
<section class="country-hero"><p class="kicker">CHAPTER {country.chapter} · {country.region}</p><div class="flag">{country.flag}</div><h1>{country.country}<br /><em>AIRBORNE HERITAGE.</em></h1><p>{country.intro}</p><span>ORIGINAL HERITAGE-INSPIRED STREETWEAR</span></section>
<section class="chapter-intro"><p class="kicker">THE AIRBORNESOLDIER CHAPTERS</p><h2>ONE SKY. A DISTINCT STORY.</h2><p>Each national chapter is developed as an original interpretation of airborne heritage. Historical references are researched separately; official insignia, unit badges and protected marks are not represented as licensed or authentic without confirmed permission.</p></section>
<section class="garments"><div class="section-head"><p class="kicker">THE FIRST EDITION</p><h2>GARMENT CONCEPTS</h2><p>Product previews only — final blanks, artwork, colourways, sizing and pricing are not yet confirmed.</p></div><div class="product-grid">{chapterProducts.map((product) => <a class="product" href={"/products/" + product.slug + "/"}><div class="product-art"><span>{country.flag}</span><b>{product.category.toUpperCase()}</b></div><small>{product.status}</small><h3>{product.name}</h3><p>{product.colour}</p><strong>VIEW CONCEPT ↗</strong></a>)}</div></section>
</main>
<footer><a href="/">AIRBORNESOLDIER®</a><span>THE SKY BROTHERHOOD</span><a href="/collection/">ALL CHAPTERS ↗</a></footer>
<style>
:root{--ink:#f1ede4;--dark:#171914;--gold:#c7a66e;--muted:#b8b1a3}*{box-sizing:border-box}body{margin:0;background:#eeeae1;color:#171914;font-family:Arial,sans-serif}a{color:inherit;text-decoration:none}.announcement{height:34px;background:#b89a68;display:grid;place-items:center;color:#171914;font-size:9px;font-weight:800;letter-spacing:3px}.site-header{height:108px;padding:10px 6%;display:flex;align-items:center;justify-content:space-between;background:#f5f1e8;border-bottom:1px solid #d3c9b8;gap:20px}.brand img{width:275px;max-height:84px;object-fit:contain}.site-header nav{display:flex;gap:30px}.site-header nav a{font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.nav-cta{padding:14px 18px;background:#c7a66e;font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.breadcrumb{padding:18px 7%;font-size:8px;letter-spacing:1.5px;color:#777165}.country-hero{padding:95px 10%;background:radial-gradient(ellipse at 78% 20%,#58594a,#30342b 48%,#171914);color:#f1ede4;min-height:440px}.kicker{font-size:9px;letter-spacing:3px;font-weight:800;color:#ad8952}.country-hero .kicker{color:#d8ba83}.flag{font-size:45px;margin-top:32px}.country-hero h1{font-size:clamp(48px,7vw,82px);line-height:.95;letter-spacing:-3px;margin:12px 0 20px}.country-hero h1 em{font:italic 400 .65em Georgia;color:#d6b77f}.country-hero>p:not(.kicker){font:17px/1.7 Georgia;color:#d4cdbf;max-width:650px}.country-hero>span{font-size:8px;letter-spacing:2px;color:#c6b797}.chapter-intro{padding:65px 10%;text-align:center;background:#e7e1d6}.chapter-intro h2,.section-head h2{font-size:30px;letter-spacing:3px}.chapter-intro>p:last-child{max-width:780px;margin:auto;font:16px/1.8 Georgia;color:#615d53}.garments{padding:70px 7%}.section-head{text-align:center;margin-bottom:35px}.section-head>p:last-child{font:14px Georgia;color:#777165}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.product-art{height:250px;background:radial-gradient(ellipse at 50% 40%,#77786b,#34372e 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:#eee5d3}.product-art span{font-size:34px}.product-art b{font-size:8px;letter-spacing:2px}.product small{display:block;margin-top:13px;font-size:8px;letter-spacing:1px;color:#987544}.product h3{font:20px Georgia;margin:8px 0}.product p{font:12px Georgia;color:#777165}.product strong{font-size:8px;letter-spacing:1px;color:#987544}footer{padding:28px 7%;display:flex;justify-content:space-between;background:#171914;color:#d9d1c2;font-size:8px;letter-spacing:2px}footer a:first-child{font-weight:800;color:#f4eee2}
@media(max-width:850px){.product-grid{grid-template-columns:repeat(2,1fr)}.site-header nav{gap:13px}}@media(max-width:620px){.site-header{height:82px;padding:8px 14px}.brand img{width:175px;max-height:62px}.site-header nav{display:none}.nav-cta{font-size:8px;padding:12px}.country-hero{padding:70px 7%}.country-hero h1{font-size:48px}.chapter-intro{padding:48px 7%}.chapter-intro h2,.section-head h2{font-size:23px}.garments{padding:50px 5%}.product-art{height:190px}footer{flex-wrap:wrap;gap:14px;padding:25px 5%}}
</style>
</body></html>