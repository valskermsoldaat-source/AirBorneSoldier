---
import "../../styles/global.css";
import { products } from "../../data/products";
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const logo = "/images/airbornesoldier-logo.svg";
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={product.description} /><title>{product.name} — AirBorneSoldier®</title></head>
<body>
<div class="announcement">THE SKY BROTHERHOOD <span>—</span> BUILT ON BELONGING</div>
<header class="site-header"><a class="brand" href="/"><img src={logo} alt="AirBorneSoldier" /></a><nav><a href="/">Home</a><a href="/collection/">Collection</a><a href="/#story">Our story</a><a href="mailto:valskermsoldaat@gmail.com">Contact</a></nav><a class="nav-cta" href={"/collection/" + product.countrySlug + "/"}>Country chapter ↗</a></header>
<main><div class="breadcrumb"><a href="/">HOME</a> / <a href="/collection/">COLLECTION</a> / <a href={"/collection/" + product.countrySlug + "/"}>{product.country.toUpperCase()}</a> / {product.name.toUpperCase()}</div>
<section class="product-layout"><div class="product-visual"><div class="visual-mark">{product.flag}<span>{product.category.toUpperCase()}</span><b>GARMENT CONCEPT</b></div><p>PRODUCT PHOTOGRAPHY WILL BE ADDED AFTER THE FINAL GARMENT AND ARTWORK ARE APPROVED.</p></div><div class="product-copy"><p class="kicker">{product.flag} {product.country.toUpperCase()} · {product.status}</p><h1>{product.name}</h1><p class="status">COMING SOON · NOT AVAILABLE TO PURCHASE</p><p class="description">{product.description}</p><div class="spec"><span>GARMENT</span><b>{product.category}</b></div><div class="spec"><span>COLOUR</span><b>{product.colour}</b></div><div class="spec"><span>PRICE</span><b>To be confirmed</b></div><div class="spec"><span>SIZES</span><b>To be confirmed</b></div><a class="interest" href={"mailto:valskermsoldaat@gmail.com?subject=" + encodeURIComponent("Early access — " + product.name)}>REGISTER INTEREST ↗</a><p class="notice">This is a concept preview, not a live product listing. Supplier, garment model, materials, print or embroidery method, colour availability, sizes and pricing must be verified before orders open. No payment is taken on this page.</p><a class="back" href={"/collection/" + product.countrySlug + "/"}>← BACK TO {product.country.toUpperCase()} CHAPTER</a></div></section></main>
<footer><a href="/">AIRBORNESOLDIER®</a><span>THE SKY BROTHERHOOD</span><a href="/collection/">ALL COLLECTIONS ↗</a></footer>
<style>
*{box-sizing:border-box}body{margin:0;background:#eeeae1;color:#1b1c17;font-family:Arial,sans-serif}a{color:inherit;text-decoration:none}.announcement{height:34px;background:#b89a68;display:grid;place-items:center;color:#171914;font-size:9px;font-weight:800;letter-spacing:3px}.site-header{height:108px;padding:10px 6%;display:flex;align-items:center;justify-content:space-between;background:#f5f1e8;border-bottom:1px solid #d3c9b8;gap:20px}.brand img{width:275px;max-height:84px;object-fit:contain}.site-header nav{display:flex;gap:30px}.site-header nav a{font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.nav-cta,.interest{padding:14px 18px;background:#c7a66e;font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.breadcrumb{padding:18px 7%;font-size:8px;letter-spacing:1.5px;color:#777165}.product-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:7%;padding:25px 7% 90px;max-width:1500px;margin:auto}.product-visual{min-height:620px;background:radial-gradient(ellipse at 50% 35%,#626457,#292d25 72%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;color:#d5c9ae}.visual-mark{height:460px;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;border:1px solid #a78a58;background:linear-gradient(145deg,#30342b,#1a1d18)}.visual-mark span{font-size:10px;letter-spacing:4px}.visual-mark b{font-size:8px;letter-spacing:2px;color:#b9955c}.visual-mark:first-letter{font-size:50px}.product-visual>p{font-size:8px;letter-spacing:1.5px;text-align:center;line-height:1.8}.product-copy{padding:35px 0}.kicker{font-size:9px;letter-spacing:2px;color:#987544}.product-copy h1{font:clamp(38px,4vw,58px)/1.05 Georgia;margin:20px 0}.status{font-size:9px;letter-spacing:1.5px;color:#987544;font-weight:800}.description{font:17px/1.7 Georgia;color:#5e5a50;margin:25px 0}.spec{display:flex;justify-content:space-between;gap:20px;padding:15px 0;border-bottom:1px solid #cfc6b7;font-size:10px}.spec span{color:#777165;letter-spacing:1.4px}.spec b{font-weight:700}.interest{display:block;text-align:center;margin-top:28px}.notice{font:13px/1.7 Georgia;color:#777165}.back{display:block;margin-top:30px;font-size:8px;letter-spacing:1.5px;color:#987544}footer{padding:28px 7%;display:flex;justify-content:space-between;background:#171914;color:#d9d1c2;font-size:8px;letter-spacing:2px}footer a:first-child{font-weight:800;color:#f4eee2}
@media(max-width:850px){.product-layout{grid-template-columns:1fr}.product-visual{min-height:480px}.visual-mark{height:360px}.site-header nav{gap:13px}}@media(max-width:620px){.site-header{height:82px;padding:8px 14px}.brand img{width:175px;max-height:62px}.site-header nav{display:none}.nav-cta{font-size:8px;padding:12px}.product-layout{padding:12px 5% 60px}.product-visual{min-height:370px}.visual-mark{height:280px}.product-copy h1{font-size:40px}footer{flex-wrap:wrap;gap:14px;padding:25px 5%}}
</style>
</body></html>