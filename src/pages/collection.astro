---
import "../styles/global.css";
import { products as pieces } from "../data/products";

---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Explore the AirBorneSoldier Sky Brotherhood collection. Premium heritage streetwear." /><meta name="theme-color" content="#171914" /><title>Collection — AirBorneSoldier®</title></head>
<body>
<div class="topline">THE SKY BROTHERHOOD — BUILT ON BELONGING</div>
<header class="header"><a class="logo" href="/" aria-label="AirBorneSoldier home"><img class="brand-image" src="https://d2ol7oe51mr4n9.cloudfront.net/user_39LyNd3yWOiGeUhnS3CdfDw25su/c14fa22d-dcdf-4531-ac68-c193884954df.png" alt="AirBorneSoldier — The Sky Brotherhood" /></a><nav><a href="/">HOME</a><a href="/collection/" aria-current="page">COLLECTION</a><a href="mailto:valskermsoldaat@gmail.com">CONTACT ↗</a></nav></header>
<main><section class="collection-hero"><p class="eyebrow">CHAPTER 01 · THE FOUNDATIONS</p><h1>THE<br /><em>COLLECTION.</em></h1><p>Considered essentials. Heritage spirit.<br />The first pieces of the Sky Brotherhood.</p></section>
<section class="catalogue"><div class="catalogue-heading"><span>THE FIRST EDITION</span><span>04 PIECES / UK · EUROPE · USA</span></div>
<div class="catalogue-grid">{pieces.map((piece,i)=><article class="piece"><a href={"/collection/" + piece.slug + "/"} class="piece-image" aria-label={"View " + piece.name}><img src={piece.image} alt={piece.name} loading="lazy" /><span>{piece.label}</span><b>0{i+1}</b></a><div class="piece-meta"><div><small>{piece.category}</small><h2>{piece.name}</h2><p>{piece.description}</p></div><strong>{piece.price}</strong></div><a class="enquire" href={"/collection/" + piece.slug + "/"}>VIEW PIECE DETAILS <span>↗</span></a></article>)}</div>
<div class="availability"><span>✳</span><div><strong>THE FIRST DROP IS IN DEVELOPMENT.</strong><p>These are concept pieces for the storefront preview. Product availability, final specifications and pricing will be confirmed before launch.</p></div></div>
</section></main><footer><a href="/">AIRBORNESOLDIER®</a><span>SKY BROTHERHOOD</span><a href="mailto:valskermsoldaat@gmail.com">CONTACT ↗</a></footer>
</body></html>
<style>
.topline{height:30px;background:#b79b6c;color:#171914;display:grid;place-items:center;font-size:8px;letter-spacing:2px;font-weight:700}.header{height:108px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff20}.logo{display:flex;align-items:center}.brand-image{display:block;width:290px;height:auto;max-height:96px;object-fit:contain;mix-blend-mode:multiply;filter:contrast(1.55) saturate(1.25) brightness(.78) drop-shadow(0 3px 2px #8b765333);transition:transform .2s ease}.brand-image:hover{transform:scale(1.025)}.header nav{display:flex;gap:30px;font-size:8px;letter-spacing:1.8px;color:#d1cdc3}.header nav a[aria-current="page"]{color:#c7ad81}
.collection-hero{padding:100px 12% 90px;background:radial-gradient(ellipse at 80% 35%,#424337,#25271f 45%,#171914 80%)}.eyebrow{font-size:8px;letter-spacing:3px;color:#c7ad81}.collection-hero h1{font-size:clamp(62px,9vw,112px);line-height:.85;letter-spacing:-6px;margin:28px 0}.collection-hero h1 em{font:italic 400 1em Georgia,serif;color:#c7ad81;letter-spacing:-4px}.collection-hero>p:last-child{font:18px/1.6 Georgia,serif;color:#c8c3b8}
.catalogue{padding:75px 8% 100px}.catalogue-heading{display:flex;justify-content:space-between;border-bottom:1px solid #ffffff35;padding-bottom:15px;margin-bottom:30px;color:#c7ad81;font-size:8px;letter-spacing:2px}.catalogue-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:45px 22px}.piece-image{height:470px;position:relative;display:block;background:#292c24;overflow:hidden}.piece-image img{width:100%;height:100%;object-fit:cover;filter:saturate(.65);transition:transform .6s}.piece-image:hover img{transform:scale(1.04)}.piece-image span,.piece-image b{position:absolute;top:16px;font-size:8px;letter-spacing:1.5px;color:white;background:#171914c9;padding:9px 11px}.piece-image span{left:16px}.piece-image b{right:16px;background:transparent}.piece-meta{display:flex;justify-content:space-between;gap:15px;padding:18px 0}.piece-meta small{color:#c7ad81;font-size:8px;letter-spacing:1.5px;text-transform:uppercase}.piece-meta h2{font:24px Georgia,serif;margin:8px 0}.piece-meta p{font:13px/1.6 Georgia,serif;color:#aaa69c;max-width:350px;margin:0}.piece-meta>strong{font-size:12px;color:#c7ad81}.enquire{display:flex;justify-content:space-between;border-top:1px solid #ffffff30;padding:14px 0;font-size:8px;letter-spacing:1.5px}.enquire span{color:#c7ad81}.availability{display:flex;gap:18px;align-items:flex-start;background:#282a23;padding:25px;margin-top:65px}.availability>span{color:#c7ad81}.availability strong{font-size:9px;letter-spacing:1.5px}.availability p{font:13px/1.6 Georgia,serif;color:#aaa69c;margin:8px 0 0}footer{padding:28px 7%;display:flex;justify-content:space-between;border-top:1px solid #ffffff20;color:#aaa69c;font-size:8px;letter-spacing:1.5px}footer a:first-child{color:#e9e5dc;font-weight:800}
@media(max-width:650px){.header{height:88px;padding:0 5%}.header nav{gap:13px;font-size:7px}.collection-hero{padding:80px 7%}.collection-hero h1{letter-spacing:-3px}.catalogue{padding:55px 5% 75px}.catalogue-heading{font-size:7px}.catalogue-grid{grid-template-columns:1fr 1fr;gap:30px 12px}.piece-image{height:270px}.piece-meta{display:block}.piece-meta h2{font-size:18px}.piece-meta p{font-size:11px}.piece-meta>strong{display:block;margin-top:10px}.availability{margin-top:45px;padding:18px}footer{padding:25px 5%;font-size:7px;gap:12px;flex-wrap:wrap}}
@media(max-width:390px){.piece-image{height:220px}.brand-image{width:220px;max-height:76px}.header nav{gap:9px}}

/* Light heritage catalogue */
body{background:#eeeae1;color:#24251f}
.header{background:#eeeae1;border-bottom:1px solid #d5cdbf}
.header nav{color:#39382f}
.header nav a[aria-current="page"]{color:#927447}
.collection-hero{background:radial-gradient(ellipse at 82% 30%,#e2dacb,#f1eee7 52%,#e8e2d7 100%);color:#24251f}
.collection-hero .eyebrow{color:#8d7042}
.collection-hero h1{color:#24251f}
.collection-hero h1 em{color:#987a48}
.collection-hero>p:last-child{color:#625e54}
.catalogue{background:#eeeae1}
.catalogue-heading{border-color:#cfc6b6;color:#8d7042}
.piece-image{background:#d9d2c5}
.piece-image img{filter:saturate(.82)}
.piece-image span,.piece-image b{color:#f8f4eb;background:#25251fe8}
.piece-meta small{color:#8d7042}
.piece-meta h2{color:#24251f}
.piece-meta p{color:#6f6a60}
.piece-meta>strong{color:#8d7042}
.enquire{border-color:#cfc6b6;color:#292820}
.enquire span{color:#987a48}
.availability{background:#ded5c4;color:#292820}
.availability strong{color:#292820}
.availability p{color:#625d53}
footer{background:#20211c;border-color:#393a32;color:#c3bdae}
footer a:first-child{color:#f0ece2}


/* Collection header uses the same dark master-brand treatment */
.header{height:142px!important;min-height:142px!important;background:#171914!important;border-bottom:1px solid #8f7549!important;padding:14px clamp(24px,7vw,100px)!important}
.header .logo{display:flex;align-items:center}
.header .brand-image{display:block;width:370px!important;max-width:38vw;height:auto!important;max-height:118px!important;object-fit:contain;mix-blend-mode:normal!important;filter:none!important;transition:transform .2s ease}
.header .brand-image:hover{transform:scale(1.02)}
.header nav,.header nav a{color:#eeeae1!important}
@media(max-width:760px){.header{height:112px!important;min-height:112px!important;padding:10px 18px!important}.header .brand-image{width:250px!important;max-width:62vw!important;max-height:88px!important}}


.header{height:186px!important;min-height:186px!important;padding:10px clamp(24px,5.5vw,90px)!important;background:#f2eee5!important;border-bottom:1px solid #d6c9b2!important}
.header .logo{width:420px!important;max-width:34vw!important;flex:0 0 420px!important;display:flex;align-items:center}
.header .brand-image{width:100%!important;max-height:166px!important;object-fit:contain!important;mix-blend-mode:normal!important;filter:contrast(1.65) brightness(.86) saturate(1.25)!important}
.header nav,.header nav a{color:#171914!important}
@media(max-width:900px){.header{height:auto!important;min-height:140px!important;padding:12px 4%!important;flex-wrap:wrap!important}.header .logo{flex:0 0 300px!important;width:300px!important;max-width:48vw!important}.header .brand-image{max-height:115px!important}}
@media(max-width:620px){.header{height:112px!important;min-height:112px!important;flex-wrap:nowrap!important;padding:8px 14px!important}.header .logo{width:220px!important;max-width:58vw!important;flex:0 0 220px!important}.header .brand-image{max-height:90px!important}}


/* Logo treatment: transparent outside, solid metallic artwork, no rectangular backing. */
.brand-image{display:block;object-fit:contain!important;mix-blend-mode:normal!important;filter:none!important;opacity:1!important}
</style>