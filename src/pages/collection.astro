---
import "../styles/global.css";
import { countries, garmentCategories, products } from "../data/products";
const logo = "/images/airbornesoldier-logo.svg";
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Explore five AirBorneSoldier country chapters and the four garment categories." /><title>Collection — AirBorneSoldier®</title></head>
<body>
<div class="announcement">THE SKY BROTHERHOOD <span>—</span> BUILT ON BELONGING</div>
<header class="site-header"><a class="brand" href="/"><img src={logo} alt="AirBorneSoldier" /></a><nav><a href="/">Home</a><a class="current" href="/collection/">Collection</a><a href="/#story">Our story</a><a href="mailto:valskermsoldaat@gmail.com">Contact</a></nav><a class="nav-cta" href="mailto:valskermsoldaat@gmail.com?subject=AirBorneSoldier%20early%20access">Early access ↗</a></header>
<main>
<section class="collection-hero"><p class="kicker">GLOBAL AIRBORNE HERITAGE</p><h1>AIRBORNE<br /><em>HERITAGE.</em></h1><p>ONE GLOBAL BROTHERHOOD. FIVE DISTINCT AIRBORNE STORIES.</p><div class="hero-line"></div><span>THE FIRST EDITION · CONCEPT PREVIEW</span></section>
<section class="categories"><div class="heading"><p class="kicker">FIND YOUR EVERYDAY STANDARD</p><h2>SHOP BY CATEGORY</h2></div><div class="category-grid">{garmentCategories.map((category) => <a id={category.slug} class="category" href={"#products-" + category.slug}><span>{category.number}</span><div class={"garment-art art-" + category.slug}></div><h3>{category.name}</h3><p>{category.note}</p><b>EXPLORE ↗</b></a>)}</div></section>
<section class="chapters"><div class="heading"><p class="kicker">FIVE COUNTRIES · ONE SKY</p><h2>THE COUNTRY CHAPTERS</h2></div><div class="country-grid">{countries.map((country) => <a class="country" href={"/collection/" + country.slug + "/"}><span>CHAPTER {country.chapter}</span><b>{country.flag}</b><h3>{country.country}</h3><p>{country.intro}</p><strong>EXPLORE COLLECTION ↗</strong></a>)}</div></section>
<section class="products">{garmentCategories.map((category) => <div class="product-group" id={"products-" + category.slug}><div class="group-heading"><div><p class="kicker">THE FIRST EDITION</p><h2>{category.name.toUpperCase()}</h2></div><span>DESIGN PREVIEW</span></div><div class="product-grid">{products.filter((p) => p.categorySlug === category.slug).slice(0,5).map((product) => <a class="product-card" href={"/products/" + product.slug + "/"}><div class="product-placeholder"><span>{product.flag}</span><b>{category.name.toUpperCase()}</b></div><small>{product.country} · {product.status}</small><h3>{product.name}</h3><p>Final garment and artwork to be confirmed</p><strong>VIEW CONCEPT ↗</strong></a>)}</div></div>)}</section>
</main>
<footer><a href="/">AIRBORNESOLDIER®</a><span>THE SKY BROTHERHOOD</span><a href="mailto:valskermsoldaat@gmail.com">CONTACT ↗</a></footer>
<style>
:root{--paper:#eeeae1;--ink:#1b1c17;--dark:#171914;--gold:#b9955c;--muted:#777165}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif}a{color:inherit;text-decoration:none}.announcement{height:34px;background:#b89a68;display:grid;place-items:center;color:#171914;font-size:9px;font-weight:800;letter-spacing:3px}.site-header{height:108px;padding:10px 6%;display:flex;align-items:center;justify-content:space-between;background:#f5f1e8;border-bottom:1px solid #d3c9b8;gap:20px}.brand img{width:275px;max-height:84px;object-fit:contain}.site-header nav{display:flex;gap:30px}.site-header nav a{font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.site-header nav .current{color:#967340}.nav-cta{padding:14px 18px;background:#c7a66e;font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.collection-hero{padding:100px 10%;background:radial-gradient(ellipse at 80% 20%,#555747,#2b3028 48%,#171914 100%);color:#f2eee4}.collection-hero h1{font-size:clamp(60px,9vw,110px);line-height:.88;letter-spacing:-5px;margin:25px 0}.collection-hero h1 em{font:italic 400 1em Georgia;color:#d2b47b}.collection-hero>p:not(.kicker){font-size:14px;letter-spacing:2.5px}.collection-hero>span{font-size:8px;letter-spacing:2px;color:#c7b99c}.hero-line{width:70px;height:1px;background:var(--gold);margin:28px 0}.kicker{font-size:9px;letter-spacing:3px;font-weight:800;color:#9b7846}.collection-hero .kicker{color:#d3b77f}.categories,.chapters,.products{padding:70px 7%}.heading{text-align:center;margin-bottom:35px}.heading h2,.group-heading h2{font-size:30px;letter-spacing:3px;margin:10px 0}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.category{padding:14px;background:#e3ddd1;border:1px solid #c6b99f}.category>span{font-size:9px;color:#987544}.garment-art{height:180px;margin:12px 0;background:radial-gradient(ellipse at 50% 40%,#77786b,#34372e 72%);position:relative}.garment-art:after{content:"";position:absolute;width:105px;height:145px;left:calc(50% - 52px);top:17px;background:linear-gradient(100deg,#171a16,#4b4c42,#171a16);clip-path:polygon(20% 0,38% 0,50% 8%,62% 0,80% 0,100% 23%,83% 38%,75% 27%,77% 100%,23% 100%,25% 27%,17% 38%,0 23%)}.art-caps:after{width:130px;height:78px;left:calc(50% - 65px);top:50px;border-radius:60%;clip-path:polygon(0 65%,12% 20%,40% 0,78% 10%,100% 65%,65% 78%,30% 100%)}.category h3{font:22px Georgia;margin:10px 0 4px}.category p{font:12px Georgia;color:#6e685d}.category b{font-size:8px;letter-spacing:1.5px;color:#8b6b3e}.chapters{background:#20231d;color:#f1ede4}.chapters .kicker{color:#c8a66d}.country-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.country{padding:22px 17px;min-height:285px;display:flex;flex-direction:column;align-items:flex-start;background:linear-gradient(150deg,#484a3e,#272a23);border:1px solid #76603d}.country>span{font-size:8px;letter-spacing:2px;color:#d0b17a}.country>b{font-size:31px;margin:25px 0 7px}.country h3{font:23px Georgia;margin:0}.country p{font:13px/1.6 Georgia;color:#c3bdaf;flex:1}.country strong{font-size:8px;letter-spacing:1px;color:#e0c48d}.products{background:#eeeae1}.product-group{margin-bottom:60px;scroll-margin-top:20px}.group-heading{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #c9c0b2;margin-bottom:20px;padding-bottom:12px}.group-heading h2{margin-bottom:0}.group-heading>span{font-size:8px;letter-spacing:2px;color:#987544}.product-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.product-card{display:block}.product-placeholder{height:210px;background:radial-gradient(ellipse at 50% 38%,#77786c,#34372e 70%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#eee5d3;gap:10px}.product-placeholder span{font-size:28px}.product-placeholder b{font-size:8px;letter-spacing:2px}.product-card small{display:block;margin-top:13px;color:#987544;font-size:8px;letter-spacing:1px}.product-card h3{font:18px Georgia;margin:8px 0}.product-card p{font:12px Georgia;color:#777165}.product-card>strong{font-size:8px;letter-spacing:1px;color:#987544}footer{padding:28px 7%;display:flex;justify-content:space-between;background:#171914;color:#d9d1c2;font-size:8px;letter-spacing:2px}footer a:first-child{font-weight:800;color:#f4eee2}
@media(max-width:950px){.country-grid{grid-template-columns:repeat(3,1fr)}.product-grid{grid-template-columns:repeat(3,1fr)}.category-grid{grid-template-columns:repeat(2,1fr)}.site-header nav{gap:14px}}
@media(max-width:620px){.site-header{height:82px;padding:8px 14px}.brand img{width:175px;max-height:62px}.site-header nav{display:none}.nav-cta{font-size:8px;padding:12px}.collection-hero{padding:75px 7%}.collection-hero h1{font-size:62px;letter-spacing:-3px}.categories,.chapters,.products{padding:52px 5%}.country-grid{grid-template-columns:repeat(2,1fr)}.product-grid{grid-template-columns:repeat(2,1fr)}.product-placeholder{height:165px}.category-grid{gap:8px}.category{padding:9px}.garment-art{height:145px}.group-heading h2{font-size:23px}footer{flex-wrap:wrap;gap:14px;padding:25px 5%}}
</style>
</body>
</html>